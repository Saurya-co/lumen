{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "sourceMap": true,
    "declaration": false,
    "lib": ["ES2020", "DOM"]
  },
  "include": ["main.ts", "preload.ts"]
}
